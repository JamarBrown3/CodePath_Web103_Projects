{
  "name": "unitygridplaza",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cd client && vite\" \"cd server && nodemon server\"",
    "reset": "cd server && node --require dotenv/config config/reset.js",
    "start": "cd server && node server",
    "build": "cd client && vite build"
  },
  "dependencies": {
    "@picocss/pico": "^1.5.7",
    "concurrently": "^7.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "nodemon": "^3.1.14",
    "pg": "^8.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  }
}
