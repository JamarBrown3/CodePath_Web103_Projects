{
  "name": "boltbucket",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/ui-server.mjs",
    "dev": "concurrently \"cd client && vite\" \"cd server && nodemon server\"",
    "start": "cd server && node server",
    "build": "cd client && vite build",
    "reset": "cd server && node --require dotenv/config config/reset.js"
  },
  "dependencies": {
    "@picocss/pico": "^1.5.7",
    "concurrently": "^7.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-modal": "^3.16.1",
    "react-router-dom": "^7.18.4",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.1.2",
    "nodemon": "^3.1.14",
    "vite": "^8.3.4"
  }
}
